{
  "name": "poolit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:student": "npm run dev --workspace @poolit/student",
    "dev:vendor": "npm run dev --workspace @poolit/vendor",
    "build": "npm run build --workspace @poolit/student && npm run build --workspace @poolit/vendor",
    "typecheck": "tsc -p apps/student --noEmit && tsc -p apps/vendor --noEmit",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
