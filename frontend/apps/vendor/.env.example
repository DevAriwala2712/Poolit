# Base URL of the Poolit backend (see ../../../backend)
VITE_API_URL=http://localhost:5057

# Supabase project — used only for vendor login (Supabase Auth).
# Safe to expose client-side: this is the publishable/anon key, not the service role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Which backend answers data calls: "express" (VITE_API_URL, the default) or "supabase"
# (the database functions through the Supabase client). Switch one app at a time; to
# roll back, set it to express and redeploy.
VITE_BACKEND=express
