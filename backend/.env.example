PORT=5057
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
NODE_ENV=development
SLOT_DURATION_MINUTES=10

# How often (ms) the in-process pool scheduler sweeps for expired open
# slots and closes them automatically. Only used by server.js (the
# long-lived local/`npm start` process) — see docs/POOLING.md.
POOL_SWEEP_INTERVAL_MS=30000

# Shared secret an external scheduler (e.g. Vercel Cron) must send as the
# `x-cron-secret` header to POST /internal/sweep-slots. Required only for
# the serverless deployment, which has no persistent process to run the
# interval above. Leave unset to disable the endpoint entirely.
CRON_SECRET=

# Comma-separated list of allowed origins for CORS, e.g.
# https://student.poolit.app,https://vendor.poolit.app
# Leave unset to allow all origins (the previous, fully-open default).
ALLOWED_ORIGINS=
# Per-store vendor access control (Phase 1). Leave false until the
# vendor_users migration is applied and every vendor login is linked to its
# store — see docs/PHASE1_RUNBOOK.md. When true, a vendor can only act on
# stores they are linked to; staff (non-owner) can't edit store settings/staff.
ENFORCE_VENDOR_SCOPING=false
